# Nothing is required to run the demo locally — signups are appended to
# data/signups.jsonl. That file is NOT durable on Vercel/Netlify (serverless
# filesystems are read-only/ephemeral), so before launch point app/api/signup/route.ts
# at a real store instead, e.g.:
#
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
#
# or a transactional email provider to notify the owner per signup:
#
# RESEND_API_KEY=
